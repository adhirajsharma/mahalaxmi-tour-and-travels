# ========================================================
# Mahalaxmi Tours and Travels - Environment Configuration
# ========================================================
# NOTE: For local development, copy this file to .env:
#   copy .env.example .env
# For Netlify deployment, add these variables in:
#   Netlify Dashboard -> Site Configuration -> Environment Variables
# ========================================================

# Server Port (Local Node.js server only; Netlify Functions ignore this)
PORT=3000

# --------------------------------------------------------
# 1. Email Notifications (Nodemailer Gmail SMTP)
# --------------------------------------------------------
# Use a Gmail App Password (not your normal Gmail password).
# How to get it: Google Account -> Security -> 2-Step Verification -> App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM="Mahalaxmi Tours & Travels <your_email@gmail.com>"
ADMIN_EMAIL=your_email@gmail.com

# --------------------------------------------------------
# 2. Meta Official WhatsApp Cloud API (Optional)
# --------------------------------------------------------
# Get these from: developers.facebook.com -> WhatsApp -> API Setup
# If left empty, enquiries will generate direct WhatsApp click-to-chat links!
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=

# Admin / Owner WhatsApp number (with country code, e.g. 919356891309)
ADMIN_WHATSAPP=919356891309
